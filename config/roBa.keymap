#include <behaviors/rgbled_widget.dtsi>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>

#define VIM 7
#define DESKTOP 3

&mt {
    flavor = "balanced";
    quick-tap-ms = <0>;
    require-prior-idle-ms = <150>;
};

&lt {
    tapping-term-ms = <200>;
    quick-tap-ms = <200>;
    flavor = "balanced";
};

&trackball {
    automouse-layer = <4>;
    scroll-layers = <5>;
};

// 點擊滑鼠鍵時延長 MOUSE 層超時至 2 秒
&mkp_input_listener { input-processors = <&zip_temp_layer 4 2000>; };

/ {
    combos {
        compatible = "zmk,combos";

        tab {
            bindings = <&kp TAB>;
            key-positions = <1 2>;    // W+E
            slow-release;
        };

        backspace {
            bindings = <&kp BACKSPACE>;
            key-positions = <6 7>;    // U+I
            slow-release;
        };

        enter {
            bindings = <&kp ENTER>;
            key-positions = <18 19>;  // J+K
            slow-release;
        };

        input_switch {
            bindings = <&input_tap>;
            key-positions = <11 12>;  // S+D = 切換輸入法
            slow-release;
        };
    };

    macros {
        to_layer_0: to_layer_0 {
            compatible = "zmk,behavior-macro-one-param";
            #binding-cells = <1>;
            bindings = <&to 0 &macro_param_1to1 &kp MACRO_PLACEHOLDER>;
            label = "TO_LAYER_0";
        };

        arrow_operator: arrow_operator {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp MINUS &kp GREATER_THAN>;
            label = "ARROW_OPERATOR";
        };

        namespace_operator: namespace_operator {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp COLON &kp COLON>;
            label = "NAMESPACE_OPERATOR";
        };

        input_tap: input_tap {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&macro_tap &kp LC(SPACE)>;
            label = "INPUT_TAP";
        };
    };

    behaviors {
        lt_to_layer_0: lt_to_layer_0 {
            compatible = "zmk,behavior-hold-tap";
            label = "LAYER_TAP_TO_0";
            bindings = <&mo>, <&to_layer_0>;

            #binding-cells = <2>;
            tapping-term-ms = <200>;
        };

        scroll_up_down: behavior_sensor_rotate_mouse_wheel_up_down {
            compatible = "zmk,behavior-sensor-rotate";
            #sensor-binding-cells = <0>;
            tap-ms = <20>;
            bindings = <&msc SCRL_UP>, <&msc SCRL_DOWN>;
        };

        scroll_right_left: mouse_wheel_right_left {
            compatible = "zmk,behavior-sensor-rotate";
            #sensor-binding-cells = <0>;
            bindings = <&msc SCRL_LEFT>, <&msc SCRL_RIGHT>;
            tap-ms = <20>;
        };

        vol_up_down: vol_up_down {
            compatible = "zmk,behavior-sensor-rotate";
            #sensor-binding-cells = <0>;
            tap-ms = <5>;
            bindings = <&kp C_VOL_DN>, <&kp C_VOL_UP>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {  // Layer 0
            bindings = <
&kp Q             &lt DESKTOP W  &kp E        &kp R            &kp T                                                     &kp Y         &kp U  &kp I      &kp O    &kp P
&kp A             &kp S          &kp D        &kp F            &kp G             &trans                &kp ESCAPE         &kp H         &kp J  &kp K      &kp L    &kp SEMICOLON
&mt LEFT_SHIFT Z  &kp X          &kp C        &kp V            &kp B             &kp LEFT_ALT          &kp RIGHT_ALT      &kp N         &kp M  &kp COMMA  &kp DOT  &mt RIGHT_SHIFT SLASH
&kp CAPS          &kp PAGE_DOWN  &kp PAGE_UP  &lt VIM SPACE    &kp LEFT_CONTROL  &kp LEFT_COMMAND      &lt 2 ENTER        &lt 1 BACKSPACE                          &lt 6 DEL
            >;

            sensor-bindings = <&scroll_up_down>;  // Encoder: 縱向捲動
        };

        SYM {  // Layer 1 - 符號層（按住 BS 啟用）
            bindings = <
&kp SQT          &kp LESS_THAN  &kp GREATER_THAN     &kp DOUBLE_QUOTES  &kp CARET                      &kp PIPE        &kp AMPERSAND  &kp LEFT_BRACKET      &kp RIGHT_BRACKET      &kp PERCENT
&kp EXCLAMATION  &kp SLASH      &kp ASTERISK         &kp BACKSLASH      &kp HASH   &trans      &trans  &kp MINUS       &kp EQUAL      &kp LEFT_PARENTHESIS  &kp RIGHT_PARENTHESIS  &kp DOLLAR
&kp TILDE        &kp GRAVE      &namespace_operator  &arrow_operator    &kp AT     &trans      &trans  &kp UNDERSCORE  &kp PLUS       &kp LEFT_BRACE        &kp RIGHT_BRACE        &kp QUESTION
&trans           &trans         &trans               &trans             &trans     &trans      &trans  &trans                                                                      &trans
            >;

            sensor-bindings = <&scroll_right_left>;  // Encoder: 水平捲動
        };

        NUM {  // Layer 2 - 數字層（按住 ENTER 啟用）
            bindings = <
&none   &kp F7  &kp F8  &kp F9  &kp F12                                       &none   &kp N7        &kp N8        &kp NUMBER_9  &trans
&none   &kp F4  &kp F5  &kp F6  &kp F11  &kp LC(LA(KP_NUMBER_0))      &trans  &none   &kp NUMBER_4  &kp N5        &kp NUMBER_6  &trans
&none   &kp F1  &kp F2  &kp F3  &kp F10  &trans                       &trans  &none   &kp NUMBER_1  &kp NUMBER_2  &kp NUMBER_3  &kp N0
&trans  &trans  &trans  &trans  &trans   &trans                       &trans  &trans                                            &trans
            >;

            sensor-bindings = <&scroll_up_down>;
        };

        DESKTOP {  // Layer 3 - 桌面切換（按住 W 啟用）
            bindings = <
&trans  &trans  &trans  &trans  &trans                      &trans        &trans        &trans      &trans         &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &kp LC(LEFT)  &kp LC(DOWN)  &kp LC(UP)  &kp LC(RIGHT)  &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans        &trans        &trans      &trans         &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans                                                 &trans
            >;

            sensor-bindings = <&scroll_up_down>;
        };

        MOUSE {  // Layer 4 - 軌跡球自動切換，G=左鍵、B=右鍵
            bindings = <
&trans  &trans  &trans  &trans  &trans                         &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &mkp MB1  &trans      &trans   &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &mkp MB2  &trans      &trans   &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans    &trans      &trans   &trans                          &trans
            >;
        };

        SCROLL {  // Layer 5 - 軌跡球捲輪模式
            bindings = <
&trans  &trans  &trans  &trans  &trans                      &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans                          &trans
            >;
        };

        bluetooth {  // Layer 6 - 藍牙設定（按住 DEL 啟用）
            bindings = <
&bt BT_SEL 0    &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4                           &trans  &trans    &trans    &trans     &trans
&bt BT_CLR      &trans        &trans        &trans        &trans        &trans      &trans       &trans  &trans    &kp UP    &trans     &trans
&bt BT_CLR_ALL  &trans        &trans        &trans        &ind_bat      &trans      &bootloader  &trans  &kp LEFT  &kp DOWN  &kp RIGHT  &trans
&trans          &trans        &trans        &trans        &trans        &trans      &trans       &trans                                  &trans
            >;
        };

        VIM {  // Layer 7 - 按住 Space，H=左 J=下 K=上 L=右
            bindings = <
&trans  &trans  &trans  &trans  &trans                      &kp HOME  &kp PAGE_DOWN  &kp PAGE_UP  &kp END    &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &kp LEFT  &kp DOWN       &kp UP       &kp RIGHT  &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans    &trans         &trans       &trans     &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans                                            &trans
            >;

            sensor-bindings = <&scroll_up_down>;
        };
    };
};
